---
import { CTA, BOOK } from "../data/site";
const { title, text, fine = "Free plan, no card needed. Nothing changes in your ad accounts.", label = CTA.label, href = CTA.href, second = false } = Astro.props;
---
<div class="cta"><div class="wrap"><div class="cta-card">
  <div><h2>{title}</h2><p>{text}</p></div>
  <div><div class="cta-actions"><a class="btn btn-primary" href={href}>{label}</a>{second && <a class="btn btn-ghost" href={BOOK.href}>{BOOK.label}</a>}</div><p class="cta-fine">{fine}</p></div>
</div></div></div>
