---
import Shot from "./Shot.astro";
// Copy here is carried over from the existing homepage, FAQ and product page. Nothing new is claimed.
const check = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="m8 12.5 2.8 2.8L16 9.8"/></svg>';
const rows = [
  { tag: "Add", title: "Start with the data you have.", text: "Type it in, import a CSV file or an Ads Manager export, or connect a store or ad account where available.", points: ["Posts, promotions, enquiries, sales and costs", "Mix typing, importing and connecting as you grow", "Connected platforms are read-only"], shot: "add", alt: "The Add your data screen in 7Captur, with three ways to bring in data: connect a platform, import a CSV file, or type it in." },
  { tag: "Understand", title: "Know where every number comes from.", text: "Every number is labelled by where it came from. Gaps and mismatches are flagged, and missing costs stay unknown instead of becoming zero.", points: ["Entered by you, imported or connected, always shown", "Plain checks on how complete and fresh your data is", "A clear step to reach the next level of evidence"], shot: "understand", alt: "The Understand screen in 7Captur, showing the evidence level, how fresh the data is and where the numbers come from." },
  { tag: "Decide", title: "One clear next step, with the reasons.", text: "One clear action, why it is suggested, what the data cannot tell us and what to record next. You choose. Nothing changes in your accounts.", points: ["Options compared, with what is unknown", "A review date on every decision", "Thin evidence gets a small test, not a confident guess"], shot: "decide", alt: "The Decide screen in 7Captur, showing a recommended next move with its evidence level and review date." },
  { tag: "Review", title: "Check how it went, every week.", text: "Your weekly summary lists what changed, what is missing and which decisions are ready to review, so you can record how it went.", points: ["What changed, how fresh the data is, what is missing", "Decisions ready to review, too early, or short of data", "A track record of what worked"], shot: "weekly", alt: "The Weekly summary screen in 7Captur, with what changed this week, what is missing and decisions ready for review." },
];
---
{rows.map((r, i) => (
  <div class={`frow${i % 2 ? " flip" : ""}`} data-reveal>
    <div class="frow-text">
      <span class="frow-tag">{r.tag}</span>
      <h3>{r.title}</h3>
      <p>{r.text}</p>
      <ul>{r.points.map((p) => <li><Fragment set:html={check} /><span>{p}</span></li>)}</ul>
      <a class="link" href="/product/">See it in the product</a>
    </div>
    <Shot name={r.shot} alt={r.alt} />
  </div>
))}
