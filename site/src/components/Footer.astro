---
import Logo from "./Logo.astro";
import { siteConfig, FOOTER_COLUMNS } from "../config/siteConfig";
const year = 2026;
---
<footer class="d-footer">
  <div class="d-wrap">
    <div class="d-foot-grid">
      <div class="d-foot-brand">
        <a href="/" class="d-logo"><Logo /><span>7Captur</span></a>
        <p>{siteConfig.thesis}</p>
      </div>
      {FOOTER_COLUMNS.map((c) => (
        <nav aria-label={c.title}>
          <h2>{c.title}</h2>
          <ul>{c.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
        </nav>
      ))}
    </div>
    <div class="d-foot-news">
      <p><strong>One short email a week.</strong> A practical note on ad spend and margin. Unsubscribe anytime.</p>
      <form action={siteConfig.newsletter.action} method="post" target="_blank">
        <label for="footEmail" class="d-sr">Email address</label>
        <input type="email" name="EMAIL" id="footEmail" placeholder="you@yourstore.com" required autocomplete="email" />
        <div class="d-hp" aria-hidden="true"><input type="text" name={siteConfig.newsletter.honeypot} tabindex="-1" value="" /></div>
        <button type="submit" class="d-btn d-btn-ghost d-btn-sm">Subscribe</button>
      </form>
    </div>
    <div class="d-foot-bottom">
      <span>© {year} 7Captur</span>
      <button type="button" class="d-linklike" id="cookieBtn" aria-controls="cookiePanel" aria-expanded="false">Cookie settings</button>
      <span class="d-foot-portal">Existing clients: <a href={siteConfig.clientPortalUrl} rel="nofollow">Client Portal Login →</a></span>
    </div>
  </div>
</footer>

<div class="d-cookie" id="cookiePanel" role="dialog" aria-label="Cookie settings" hidden>
  <h2>Cookies and storage</h2>
  <p>7captur.com sets no tracking or advertising cookies. Your browser stores one preference, your light or dark theme, so the site remembers it. Text fonts load from Google Fonts. The client portal has its own settings.</p>
  <p>If we add analytics later, it will be optional and off until you choose.</p>
  <button type="button" class="d-btn d-btn-primary d-btn-sm" id="cookieClose">Got it</button>
</div>
<script is:inline>
(function(){
  var b=document.getElementById('cookieBtn'),p=document.getElementById('cookiePanel'),c=document.getElementById('cookieClose');
  function set(o){p.hidden=!o;b.setAttribute('aria-expanded',String(o));if(o)c.focus();else b.focus();}
  b.addEventListener('click',function(){set(p.hidden)});
  c.addEventListener('click',function(){set(false)});
  document.addEventListener('keydown',function(e){if(e.key==='Escape'&&!p.hidden)set(false)});
})();
</script>
