---
import { LOGO_NAMES } from "../data/integrations";
const order = ["shopify", "woocommerce", "wordpress", "bigcommerce", "stripe", "paypal", "googleads", "meta", "tiktok", "amazonads", "linkedinads", "instagram", "whatsapp"];
---
<div class="marquee" role="img" aria-label="Works with Shopify, WooCommerce, WordPress, BigCommerce, Stripe, PayPal, Google Ads, Meta, TikTok, Amazon Ads, LinkedIn Ads, Instagram and WhatsApp">
  <div class="marquee-track">
    {[0, 1, 2].map((n) => (
      <ul aria-hidden="true">
        {order.map((k) => <li><img src={`/assets/logos/brands/${k}.svg`} alt="" width="30" height="30" loading="lazy" class={`brand brand-${k}`} /></li>)}
      </ul>
    ))}
  </div>
</div>
