---
import { LOGO_NAMES } from "../data/integrations";
const order = ["shopify", "googleads", "meta", "instagram", "tiktok", "whatsapp", "woocommerce"];
---
<div class="marquee" role="img" aria-label="Works with Shopify, Google Ads, Meta, Instagram, TikTok, WhatsApp and WooCommerce">
  <div class="marquee-track">
    {[0, 1, 2].map((n) => (
      <ul aria-hidden="true">
        {order.map((k) => <li><img src={`/assets/logos/brands/${k}.svg`} alt="" width="30" height="30" loading="lazy" class={`brand brand-${k}`} /></li>)}
      </ul>
    ))}
  </div>
</div>
