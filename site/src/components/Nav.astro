---
import Logo from "./Logo.astro";
import { NAV, MEGA, CTA, LOGIN } from "../data/site";
const { current = "" } = Astro.props;
const menuIcon = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 7h18M3 12h18M3 17h18"/></svg>';
const closeIcon = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>';
const chev = '<svg width="10" height="10" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m2.5 4.5 3.5 3.5 3.5-3.5"/></svg>';
const here = (h) => { const p = h.split("#")[0]; return p !== "/" && p !== "" && (current === p || current.startsWith(p)); };
---
<nav class="nav" aria-label="Main">
  <div class="nav-inner">
    <a href="/" class="logo"><Logo />7Captur</a>
    <ul class="nav-links">
      {MEGA.map((m) => (
        <li class={m.items ? "has-mega" : undefined}>
          <a href={m.href} aria-current={here(m.href) ? "page" : undefined}>{m.label}{m.items && <Fragment set:html={chev} />}</a>
          {m.items && (
            <div class="mega">
              <ul>{m.items.map((it) => <li><a href={it.href}><b>{it.title}</b><span>{it.text}</span></a></li>)}</ul>
            </div>
          )}
        </li>
      ))}
    </ul>
    <div class="nav-right">
      <a class="nav-login" href={LOGIN.href}>{LOGIN.label}</a>
      <a class="btn btn-primary btn-sm" href={CTA.href}>{CTA.label}</a>
      <button class="icon-btn" id="themeToggle" type="button" aria-label="Toggle theme"></button>
      <button class="icon-btn nav-menu-btn" id="menuBtn" type="button" aria-label="Open menu" aria-controls="drawer" set:html={menuIcon}></button>
    </div>
  </div>
</nav>

<div class="drawer" id="drawer" role="dialog" aria-label="Menu">
  <div class="drawer-head">
    <a href="/" class="logo"><Logo />7Captur</a>
    <button class="icon-btn" id="drawerClose" type="button" aria-label="Close menu" set:html={closeIcon}></button>
  </div>
  {NAV.map((n) => <a href={n.href}>{n.label}</a>)}
  <a href={LOGIN.href}>{LOGIN.label}</a>
  <a class="btn btn-primary" href={CTA.href}>{CTA.label}</a>
</div>
