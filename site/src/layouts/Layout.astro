---
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { siteConfig, PRICING } from "../config/siteConfig";
// Pass `title`, `description` and `path` for generated SEO tags.
// `legacy`, `head` and `scripts` exist only for pages not yet rebuilt.
const { head = "", current = "", scripts = "", title = "", description = "", path = "", noindex = false, jsonld = [], ogImage: ogImg = "", ogType = "website", published = "", modified = "", legacy = false } = Astro.props;
const url = `${siteConfig.url}${path}`;
const ogImage = `${siteConfig.url}${ogImg || "/assets/og/og-default.png"}`;
const org = `${siteConfig.url}/#org`;
const base = [
  { "@context": "https://schema.org", "@type": "Organization", "@id": org, name: "7Captur", url: `${siteConfig.url}/`, logo: `${siteConfig.url}/favicon-dark.png`, email: siteConfig.founder.email },
  { "@context": "https://schema.org", "@type": "WebSite", "@id": `${siteConfig.url}/#website`, url: `${siteConfig.url}/`, name: "7Captur", inLanguage: "en", publisher: { "@id": org } },
];
const offer = (name: string, price: number, page: string) => ({ "@type": "Offer", name, price: String(price), priceCurrency: "USD", url: `${siteConfig.url}${page}` });
const service = ["/", "/pricing/", "/audit/"].includes(path)
  ? [{ "@context": "https://schema.org", "@type": "Service", name: "7Captur Weekly Profit and Ad Decision Desk", provider: { "@id": org }, serviceType: "Marketing finance decision support for e-commerce", offers: [offer("Free 60-Day Ad Leak Audit", 0, "/audit/"), offer(`${PRICING.core.name} (monthly)`, PRICING.core.monthly, "/pricing/"), offer(`${PRICING.scale.name} (monthly)`, PRICING.scale.monthly, "/pricing/")] }]
  : [];
const graph = [...base, ...service, ...jsonld];
const legacyCss = ["site", "site-v2", "site-v3", "site-v4", "site-v5"];
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<script is:inline>try{var s=localStorage.getItem('theme');if(s?s==='dark':window.matchMedia('(prefers-color-scheme: dark)').matches)document.documentElement.classList.add('dark')}catch(e){}</script>
<Fragment set:html={head} />
{title && (<>
<title>{title}</title>
<meta name="description" content={description} />
{path && <link rel="canonical" href={url} />}
{noindex ? <meta name="robots" content="noindex" /> : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />}
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content="7Captur" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{path && <meta property="og:url" content={url} />}
<meta property="og:image" content={ogImage} />
{published && <meta property="article:published_time" content={published} />}
{modified && <meta property="article:modified_time" content={modified} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<link rel="alternate" type="application/rss+xml" title="7Captur Resources" href="/rss.xml" />
<link rel="icon" href="/favicon-light.png" media="(prefers-color-scheme: light)" />
<link rel="icon" href="/favicon-dark.png" media="(prefers-color-scheme: dark)" />
{graph.map((g) => <script is:inline type="application/ld+json" set:html={JSON.stringify(g)} />)}
</>)}
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
{legacy && <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />}
{legacy && legacyCss.map((f) => <link rel="stylesheet" href={`/assets/css/${f}.css`} />)}
<link rel="stylesheet" href="/assets/css/desk.css" />
</head>
<body class={legacy ? undefined : "desk"}>
<Nav current={current} />
<div id="content" tabindex="-1">
<slot />
</div>
<Footer />
<Fragment set:html={scripts} />
</body>
</html>
