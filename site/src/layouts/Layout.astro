---
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Reveal from "../components/Reveal.astro";
// `head` is page-specific head HTML (title, description, canonical, social tags).
// Layout owns charset, viewport, theme bootstrap, fonts and the stylesheet.
// Pass `title` + `description` (+ `path`) for generated SEO tags, or legacy raw `head` HTML.
const { head = "", current = "", scripts = "", title = "", description = "", path = "", noindex = false } = Astro.props;
const url = `https://7captur.com${path}`;
const ogImage = "https://7captur.com/assets/og/og-default.png";
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<script is:inline>try{if(localStorage.getItem('theme')!=='light')document.documentElement.classList.add('dark')}catch(e){document.documentElement.classList.add('dark')}</script>
<Fragment set:html={head} />
{title && (<>
<title>{title}</title>
<meta name="description" content={description} />
{path && <link rel="canonical" href={url} />}
{noindex && <meta name="robots" content="noindex" />}
<meta property="og:type" content="website" />
<meta property="og:site_name" content="7Captur" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{path && <meta property="og:url" content={url} />}
<meta property="og:image" content={ogImage} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<link rel="icon" href="/favicon-light.png" media="(prefers-color-scheme: light)" />
<link rel="icon" href="/favicon-dark.png" media="(prefers-color-scheme: dark)" />
<link rel="shortcut icon" href="/favicon-dark.png" />
</>)}
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@500;600;700;800&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="/assets/css/site.css" />
<link rel="stylesheet" href="/assets/css/site-v2.css" />
<link rel="stylesheet" href="/assets/css/site-v3.css" />
<link rel="stylesheet" href="/assets/css/site-v4.css" />
</head>
<body>
<div class="bgflow" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
<Nav current={current} />
<slot />
<Footer />
<Reveal />
<script is:inline>
(function(){
  var root = document.documentElement, btn = document.getElementById('themeToggle');
  var moon = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>';
  var sun = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4.5"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>';
  function paint(){ btn.innerHTML = root.classList.contains('dark') ? sun : moon; }
  btn.addEventListener('click', function(){
    root.classList.toggle('dark');
    try { localStorage.setItem('theme', root.classList.contains('dark') ? 'dark' : 'light'); } catch(e) {}
    paint();
  });
  paint();
  var d = document.getElementById('drawer');
  document.getElementById('menuBtn').addEventListener('click', function(){ d.classList.add('open'); document.body.style.overflow='hidden'; });
  document.getElementById('drawerClose').addEventListener('click', function(){ d.classList.remove('open'); document.body.style.overflow=''; });
  d.querySelectorAll('a').forEach(function(a){ a.addEventListener('click', function(){ d.classList.remove('open'); document.body.style.overflow=''; }); });
  document.addEventListener('keydown', function(e){ if(e.key==='Escape'){ d.classList.remove('open'); document.body.style.overflow=''; } });
})();
</script>
<script is:inline>
// Condensed light: a soft highlight follows the pointer across glass surfaces.
(function(){
  if(!window.matchMedia('(hover:hover)').matches) return;
  var sel='.win,.layer,.res,.platform,.plan,.cap,.fact,.rm-panel,.pipe>li,.cta-card';
  document.addEventListener('pointermove',function(e){
    var t=e.target.closest&&e.target.closest(sel); if(!t) return;
    var r=t.getBoundingClientRect(); t.style.setProperty('--mx',(e.clientX-r.left)+'px'); t.style.setProperty('--my',(e.clientY-r.top)+'px');
  },{passive:true});
})();
</script>
<Fragment set:html={scripts} />
</body>
</html>
