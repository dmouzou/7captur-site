---
import Layout from "../layouts/Layout.astro";
const head = `<title>Page not found | 7Captur</title><meta name="robots" content="noindex">`;
---
<Layout head={head}>
  <main>
    <section class="section"><div class="wrap">
      <h1>Page not found</h1>
      <p>That page does not exist or has moved.</p>
      <p><a class="btn btn-primary" href="/">Back to the homepage</a></p>
    </div></section>
  </main>
</Layout>
