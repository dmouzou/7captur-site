---
import Layout from "../../layouts/Layout.astro";
import PageHead from "../../components/PageHead.astro";
import { ReconcileUnknown } from "../../components/DeskCards";
import { MarginSplit, Independent } from "../../components/Scenes";
import Reviewer from "../../components/Reviewer.astro";
import CtaBand from "../../components/CtaBand.astro";
import { siteConfig } from "../../config/siteConfig";
const principles = [
  { Art: MarginSplit, h: "Margin before ROAS", p: "A platform's ROAS counts revenue it attributes to itself. Refunds, product costs, shipping and fees decide whether that revenue was worth buying." },
  { Art: ReconcileUnknown, h: "Conservative grading beats hype", p: "Every call carries an evidence grade. When data is missing or refunds are unsettled, the memo says so and holds back." },
  { Art: Independent, h: "A decision desk, not an agency", p: "We do not sell media, creative or a share of your spend. We stay independent so the answer can be to spend less." },
];
---
<Layout title="About: An Independent Ad Decision Desk | 7Captur" description="Why 7Captur grades evidence conservatively and works as an independent decision desk for e-commerce ad budgets, not an ad agency." path="/about/" current="/about/">
<main>
  <PageHead wide title="Ad platforms grade their own work. We check it against your margin." />

  <section class="section" style="padding-top:0">
    <div class="wrap">
      <div class="d-prose">
        <p>E-commerce marketing runs on numbers that tend to flatter. A platform reports a sale that a refund later erases. A campaign shows a healthy ROAS while the products it sells cost more to make, ship and process than the ad brought back.</p>
        <p>7Captur exists to give founders one honest read each week: what the money did after real costs, how strong the evidence is, and what to cut, hold or test next. You make the decision, and you or your media buyer make the change.</p>
      </div>
    </div>
  </section>

  <section class="section band" aria-labelledby="principles-h">
    <div class="wrap">
      <div class="section-head"><h2 id="principles-h">How we operate</h2></div>
      <ul class="d-cols d-principles" data-reveal>{principles.map(({ Art, h, p }) => <li><figure class="d-principle-art"><Art /></figure><h3>{h}</h3><p>{p}</p></li>)}</ul>
    </div>
  </section>

  <section class="section" aria-labelledby="founder-h">
    <div class="wrap">
      <div class="section-head"><h2 id="founder-h">Who is accountable</h2></div>
      <div class="d-founder d-panel"><Reviewer showFounderEmail statement="A named person answers for the work. Questions about a memo, your data or the way a call was graded can go directly to the founder." /></div>
    </div>
  </section>

  <section class="section band" id="contact" aria-labelledby="contact-h">
    <div class="wrap">
      <div class="section-head"><h2 id="contact-h">Contact</h2></div>
      <dl class="d-grid-3 d-contact">
        <div class="d-box"><dt>Book an audit</dt><dd><a href="/audit/">Free 60-Day Ad Leak Audit</a></dd></div>
        <div class="d-box"><dt>Email</dt><dd><a href={`mailto:${siteConfig.contactEmail}`}>{siteConfig.contactEmail}</a></dd></div>
        <div class="d-box"><dt>Response time</dt><dd>Within 1 business day</dd></div>
      </dl>
    </div>
  </section>

  <CtaBand />
</main>
</Layout>
