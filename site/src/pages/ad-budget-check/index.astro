---
import Layout from "../../layouts/Layout.astro";
import PageHead from "../../components/PageHead.astro";
import CtaBand from "../../components/CtaBand.astro";
import LeakEstimator from "../../components/LeakEstimator.tsx";
---
<Layout title="Ad Leak Estimator: How Much Ad Spend Could Be Leaking? | 7Captur" description="Estimate what unprofitable campaigns could cost each month from your ad spend, reported ROAS and cost drag. An illustrative estimate that runs in your browser." path="/ad-budget-check/" current="/ad-budget-check/">
<main>
  <PageHead wide title="How much could be leaking each month?" lede="Move the four inputs. The figures update in your browser and nothing is sent anywhere." />
  <section class="section" style="padding-top:0">
    <div class="wrap"><LeakEstimator client:load /></div>
  </section>
  <CtaBand />
</main>
</Layout>
