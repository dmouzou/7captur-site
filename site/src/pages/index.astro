---
import Layout from "../layouts/Layout.astro";
import CtaBand from "../components/CtaBand.astro";
import HeroWords from "../components/HeroWords";
import HeroCarousel from "../components/HeroCarousel";
import BeforeAfter from "../components/BeforeAfter";
import DeskCards from "../components/DeskCards";
import { PRICING, usd } from "../config/siteConfig";

const problems = [
  { h: "Platforms count revenue, not what you keep", p: "Ad platforms claim gross revenue before refunds, COGS, and shipping. A campaign can report a healthy ROAS and still lose cash on every order." },
  { h: "Missing costs quietly become zero", p: "Cheap trackers silently treat a missing cost input as zero. The products you know least about then look like your most profitable ones." },
  { h: "Monday has no spare four hours", p: "Founders do not have four hours every Monday to audit CSVs or argue with media-buyer screenshots." },
];
const jumps = [
  { h: "See how it works", p: "Access, reconciliation and delivery, step by step.", href: "/how-it-works/" },
  { h: "Read the full sample memo", p: "Every section of a Monday memo, explained.", href: "/sample-memo/" },
  { h: "Try the Leak Estimator", p: "Estimate what unprofitable campaigns could cost you each month.", href: "/ad-budget-check/" },
];
---
<Layout
  title="7Captur | Weekly Profit and Ad Decision Desk for E-commerce"
  description="Every Monday, 7Captur reconciles Shopify, Meta and Google exports against COGS, shipping, fees and 30-day refunds, then delivers a 1-page, analyst-verified decision memo."
  path="/" current="/">
<main>
  <header class="hero">
    <div class="wrap hero-grid is-product">
      <div>
        <p class="kicker">Weekly Profit &amp; Ad Decision Desk for e-commerce ($20K–$150K/mo ad spend)</p>
        <h1><span class="h1-line">Platform ROAS lies.</span> <span class="h1-line h1-nowrap">Get one <HeroWords client:load words={["honest", "margin-true", "analyst-checked"]} /></span> <span class="h1-line">weekly budget decision.</span></h1>
        <p class="hero-sub">Every Monday morning, 7Captur reconciles your Shopify, Meta, and Google exports against real COGS, shipping, payment fees, and 30-day refunds. Then it delivers a 1-page, analyst-verified decision memo telling you exactly what to cut, hold, or test.</p>
        <div class="hero-actions">
          <a class="btn btn-primary" href="/audit/">Book Free 60-Day Ad Leak Audit</a>
          <a class="btn btn-ghost" href="/sample-memo/">Read a sample Monday Memo</a>
        </div>
        <ul class="d-trust">
          <li>48-hour lookback turnaround</li>
          <li>Read-only viewer access</li>
          <li>Zero OAuth apps</li>
          <li>Flat {usd(PRICING.core.monthly)} Core / {usd(PRICING.scale.monthly)} Scale, never % of spend</li>
        </ul>
      </div>
      <div class="hero-carousel"><HeroCarousel client:load /></div>
    </div>
  </header>

  <section class="section">
    <div class="wrap">
      <div class="section-head" data-reveal><h2>From scattered numbers to one honest call.</h2><p class="lede">Drag the handle to see the difference.</p></div>
      <div data-reveal><BeforeAfter client:visible /></div>
    </div>
  </section>

  <section class="section band" aria-label="Sample memo excerpt">
    <div class="wrap d-narrow">
      <article class="d-panel" data-reveal>
        <p class="d-num">Sample anonymized memo · Trailing 30 days (settled) · Evidence grade: Moderate</p>
        <h2 style="margin:10px 0 12px">Executive readout</h2>
        <p>Ad platforms reported blended 3.1x ROAS on $42,800 spend. After reconciling declared SKU COGS, payment processing fees, shipping, and settled 30-day refunds, true net contribution was +$6,120, with the retargeting catalogue losing cash.</p>
        <p><strong>This week's decision:</strong> reduce Meta Retargeting Catalogue by 40%. Do not scale Google PMax until the open refund window settles.</p>
        <p class="d-fine">Illustrative figures. This is an anonymized sample, not a client account.</p>
        <p style="margin-top:16px"><a class="btn btn-ghost" href="/sample-memo/">Read the full sample memo →</a></p>
      </article>
    </div>
  </section>

  <section class="section band">
    <div class="wrap">
      <div class="section-head"><h2>Why dashboards don't stop cash leaks.</h2></div>
      <ul class="d-cols" data-reveal>{problems.map((x, i) => <li><p class="d-num">({"abc"[i]})</p><h3>{x.h}</h3><p>{x.p}</p></li>)}</ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head" data-reveal><h2>Three steps from exports to a decision.</h2><p class="lede">Open any card to see how it works.</p></div>
      <div data-reveal><DeskCards client:visible ctaHref="/audit/" ctaLabel="Book Free 60-Day Ad Leak Audit" /></div>
    </div>
  </section>

  <section class="section band">
    <div class="wrap">
      <div class="section-head"><h2>Go a level deeper.</h2></div>
      <ul class="d-cols" data-reveal>{jumps.map((j) => <li><h3>{j.h}</h3><p>{j.p}</p><p style="margin-top:14px"><a href={j.href}>Open →</a></p></li>)}</ul>
    </div>
  </section>

  <CtaBand />
</main>
</Layout>
