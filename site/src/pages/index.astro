---
import { ARTICLES } from "../data/articles";
import Layout from "../layouts/Layout.astro";
import Faq from "../components/Faq.astro";
import CtaBand from "../components/CtaBand.astro";
import ArticleCarousel from "../components/ArticleCarousel";
import LayerCards from "../components/LayerCards";
import Marquee from "../components/Marquee.astro";
import Tabs from "../components/Tabs";
import HeroWords from "../components/HeroWords.tsx";
import HeroCarousel from "../components/HeroCarousel";
import BeforeAfter from "../components/BeforeAfter";
import ProductTour from "../components/ProductTour";
import Icon from "../components/Icon.astro";
import { RecCard, ProvTable, EvidenceMeter, ImportPreview, Digest, HubMock } from "../components/Mockups";
import { CTA, BOOK } from "../data/site";

const faq = [
  { q: "Do I need a website or an ad account?", a: "No. You can start by typing in your posts, promotions, enquiries, sales and costs, or importing a CSV file. Connecting a store or ad account is optional." },
  { q: "What does 7Captur actually tell me?", a: "One clear next step, why it is suggested, what the data cannot tell us, and what to record next. When the evidence is thin, it says so and suggests a small test instead of guessing." },
  { q: "Will it change my ads or posts?", a: "No. 7Captur only reads data and gives you recommendations. You decide whether to act, and you make any change yourself in your own accounts." },
  { q: "What if I do not know my costs?", a: "Missing costs are treated as unknown, never as zero. You still get guidance, but 7Captur will not claim profit or return after costs until you provide the costs it needs." },
  { q: "Can I use it if customers order through DMs or WhatsApp?", a: "Yes. Log enquiries and sales by hand. Sales that cannot be tied to a post or promotion still count toward your business totals, and they are labelled as unknown source." },
  { q: "Can I bring in Meta or Google ad data?", a: "Yes. Import an Ads Manager export, or connect Google Ads directly where available. Every number is labelled by where it came from: entered by you, imported, or connected." },
  { q: "Which currencies are supported?", a: "Each business picks its own currency, and original amounts are kept. Records in a different currency are left out of comparisons, with a warning, rather than silently mixed." },
  { q: "Is my data safe?", a: "We ask for the narrowest access that works, store connection credentials encrypted, and let you disconnect, export or delete at any time. See the <a href=\"/security/\">security page</a>." },
];
---
<Layout
  title="7Captur | Grow your business with one clear decision"
  description="Turn your marketing activity into clear, evidence-based next steps, from social posts and messages to paid ads and e-commerce sales. Start with the data you have."
  path="/" current="/">
<main>

<header class="hero">
  <div class="wrap hero-grid is-product">
    <div>
      <h1><span class="h1-line">Grow your business</span> <span class="h1-line h1-nowrap">with one <HeroWords client:load /> decision</span></h1>
      <p class="hero-sub">Turn your marketing activity into clear, evidence-based next steps, from social posts and messages to paid ads and e-commerce sales. Start with the data you have. Add more as you grow.</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={CTA.href}>{CTA.label}</a>
        <a class="btn btn-ghost" href={BOOK.href}>{BOOK.label}</a>
      </div>
    </div>
    <div class="hero-stage">
      <span class="float f1" aria-hidden="true"><img class="brand brand-shopify" src="/assets/logos/brands/shopify.svg" alt="" /></span>
      <span class="float f2" aria-hidden="true"><img class="brand brand-meta" src="/assets/logos/brands/meta.svg" alt="" /></span>
      <span class="float f3" aria-hidden="true"><img class="brand brand-googleads" src="/assets/logos/brands/googleads.svg" alt="" /></span>
      <span class="float f4" aria-hidden="true"><img class="brand brand-instagram" src="/assets/logos/brands/instagram.svg" alt="" /></span>
      <HeroCarousel client:load />
    </div>
  </div>
</header>

<section class="section">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <h2>From scattered numbers to one next step.</h2>
      <p class="lede">Three layers, one engine. It picks how far to go from the data in front of it, not from the plan you are on.</p>
    </div>
    <div data-reveal style="margin-bottom:48px"><BeforeAfter client:visible /></div>
    <div data-reveal><LayerCards ctaHref={CTA.href} ctaLabel={CTA.label} client:visible /></div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <h2>Recommendations first. No dashboard maze.</h2>
      <p class="lede">Most tools hand you charts and leave the thinking to you. 7Captur leads with one clear next step, then helps you check how it went.</p>
    </div>
    <div class="facts" data-reveal>
      <div class="fact"><h3>Decide</h3><p>One recommended move, with the reasons and what we do not know yet.</p></div>
      <div class="fact"><h3>Review</h3><p>Every decision gets a review date, and your weekly summary lists what is waiting.</p></div>
      <div class="fact"><h3>Learn</h3><p>Record how it went and keep a history of what worked.</p></div>
    </div>
    <p class="fine"><a href="/product/#review">See how the review loop works</a></p>
  </div>
</section>

<section class="section" id="audiences">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <h2>Useful before your data is perfect.</h2>
      <p class="lede">Pick the way you sell. The engine is the same. The depth depends on the data you give it.</p>
    </div>
    <div data-reveal><Tabs client:visible /></div>
  </div>
</section>

<section class="section band" id="tour">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <h2>Take the tour.</h2>
      <p class="lede">Click through the five screens you will use. Nothing here needs an account.</p>
    </div>
    <div data-reveal><ProductTour client:visible /></div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="split" id="evidence" data-reveal>
      <div>
        <h3>Likes do not prove sales. We say so.</h3>
        <p>7Captur matches its advice to the evidence you have, and tells you plainly what more data would unlock. Thin evidence gets a small test, not a confident guess.</p>
        <a class="link" href="/product/">See the evidence modes</a>
      </div>
      <div class="stage"><EvidenceMeter client:visible /></div>
    </div>
  </div>
</section>

<section class="section band" id="connections">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <h2>Connect or Import your data. Your choice.</h2>
      <p class="lede">Connect a store or ad account, import a CSV, or type it in. Whatever fits your day.</p>
    </div>
    <div data-reveal><Marquee /></div>
    <p class="fine">Connected platforms are read-only. <a href="/security/">Read the security details</a>.</p>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <h2>Read before you decide.</h2>
      <p class="lede">Plain-language notes on measuring marketing without fooling yourself. Visit the resources page, or try our free ad budget check to see where your spend stands.</p>
    </div>
    <div data-reveal><ArticleCarousel client:visible items={ARTICLES.map((a) => ({ slug: a.slug, topic: a.topic, title: a.title, description: a.description }))} /></div>
    <div class="res-cta" data-reveal>
      <a class="btn btn-primary" href="/resources/">Go to the resources page</a>
      <a class="btn btn-ghost" href="/ad-budget-check/">Try the free ad budget check</a>
    </div>
  </div>
</section>

<section class="section band">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <h2>What people ask first.</h2>
    </div>
    <Faq items={faq} />
    <p class="fine">Something else? <a href="/contact/">Ask us directly</a>.</p>
  </div>
</section>


<CtaBand title="Find out what your marketing is really doing." text="Start your free trial with the data you already have." second />


</main>
</Layout>
