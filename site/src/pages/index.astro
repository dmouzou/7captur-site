---
import Layout from "../layouts/Layout.astro";
import Faq from "../components/Faq.astro";
import CtaBand from "../components/CtaBand.astro";
import IntegrationGrid from "../components/IntegrationGrid.astro";
import Marquee from "../components/Marquee.astro";
import Tabs from "../components/Tabs";
import { RecCard, ProvTable, EvidenceMeter, ImportPreview, Digest } from "../components/Mockups";
import insight from "../fragments/insight.html?raw";
import { CTA } from "../data/site";

const faq = [
  { q: "Do I need a website or an ad account?", a: "No. You can start by typing in your posts, promotions, enquiries, sales and costs, importing a spreadsheet, or uploading a screenshot. Connecting a store or ad account is optional." },
  { q: "What does 7Captur actually tell me?", a: "One clear next step, why it is suggested, what the data cannot tell us, and what to record next. When the evidence is thin, it says so and suggests a small test instead of guessing." },
  { q: "Will it change my ads or posts?", a: "No. 7Captur only reads data and gives you recommendations. You decide whether to act, and you make any change yourself in your own accounts." },
  { q: "What if I do not know my costs?", a: "Missing costs are treated as unknown, never as zero. You still get guidance, but 7Captur will not claim profit or return after costs until you provide the costs it needs." },
  { q: "Can I use it if customers order through DMs or WhatsApp?", a: "Yes. Log enquiries and sales by hand. Sales that cannot be tied to a post or promotion still count toward your business totals, and they are labelled as unknown source." },
  { q: "Can I bring in Meta or Google ad data?", a: "Yes. Import an Ads Manager export, or connect Google Ads directly where available. Every number is labelled by where it came from: entered by you, imported, extracted from a screenshot, or connected." },
  { q: "Which currencies are supported?", a: "Each business picks its own currency, and original amounts are kept. Records in a different currency are left out of comparisons, with a warning, rather than silently mixed." },
  { q: "Is my data safe?", a: "We ask for the narrowest access that works, store connection credentials encrypted, and let you disconnect, export or delete at any time. See the <a href=\"/security/\">security page</a>." },
];
---
<Layout
  title="7Captur | Know what's working. Decide what to do next."
  description="7Captur turns your marketing activity into clear, evidence-based next steps, from social posts and messages to paid ads and e-commerce sales. Start with the data you have."
  path="/" current="/">
<main>

<header class="hero">
  <div class="wrap hero-grid is-product">
    <div>
      <h1>Know what's working. Decide what to do next.</h1>
      <p class="hero-sub">7Captur turns your marketing activity into clear, evidence-based next steps, from social posts and messages to paid ads and e-commerce sales. Start with the data you have. Add more as you grow.</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={CTA.href}>{CTA.label}</a>
        <a class="btn btn-ghost" href="/how-it-works/">See how it works</a>
      </div>
      <div class="trust-row">
        <span>Free plan, no card needed</span>
        <span>No website required</span>
        <span>Nothing changes in your ad accounts</span>
      </div>
    </div>
    <RecCard
      move="Run a small, time-limited test on the video that brought more enquiries per dollar spent. Do not raise the budget yet."
      why="In the data entered, this video produced more enquiries for each dollar of promotion than the comparison post. That is an early signal for your goal of more enquiries."
      unknown="Enquiries are not yet linked to confirmed orders, so we cannot say which post earned more revenue or profit."
      next="Spend, enquiries and confirmed orders over the same test window."
      tags={["Evidence: partial", "Source: entered by you", "Sales attribution: unknown"]}
    />
  </div>
</header>

<Marquee />

<section class="section">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <h2>From scattered numbers to one next step.</h2>
      <p class="lede">Three layers, one engine. It picks how far to go from the data in front of it, not from the plan you are on.</p>
    </div>
    <div class="layers" data-reveal>
      <div class="layer"><h3>Add</h3><p>Type it in, import a spreadsheet or an Ads Manager export, upload a screenshot, or connect a store or ad account where available.</p><ul><li>Posts</li><li>Promotions</li><li>Enquiries</li><li>Sales</li><li>Costs</li></ul></div>
      <div class="layer"><h3>Understand</h3><p>Every number is labelled by where it came from. Gaps and mismatches are flagged, and missing costs stay unknown instead of becoming zero.</p><ul><li>Evidence labels</li><li>Gap checks</li><li>Currency safe</li></ul></div>
      <div class="layer"><h3>Decide</h3><p>One clear action, why it is suggested, what the data cannot tell us and what to record next. You choose. Nothing changes in your accounts.</p><ul><li>Recommendations</li><li>Weekly summary</li></ul></div>
    </div>
  </div>
</section>

<section class="section band">
  <div class="wrap">
    <div class="split" data-reveal>
      <div>
        <h3>Every number says where it came from.</h3>
        <p>Entered by you, imported, read from a screenshot you confirmed, or connected. Sales that cannot be tied to a post stay labelled as unknown source, and still count toward your totals.</p>
      </div>
      <div class="stage"><ProvTable /></div>
    </div>
    <div class="split rev" id="evidence" data-reveal>
      <div>
        <h3>Likes do not prove sales. We say so.</h3>
        <p>7Captur matches its advice to the evidence you have, and tells you plainly what more data would unlock. Thin evidence gets a small test, not a confident guess.</p>
        <a class="link" href="/how-it-works/">See the evidence modes</a>
      </div>
      <div class="stage"><EvidenceMeter level={2} /></div>
    </div>
    <div class="split" data-reveal>
      <div>
        <h3>Bring in what you already have.</h3>
        <p>Drop in a spreadsheet or an Ads Manager export. Columns are matched for you and shown for review. Screenshot values wait for your confirmation before anything is saved.</p>
      </div>
      <div class="stage"><ImportPreview /></div>
    </div>
    <div class="split rev" data-reveal>
      <div>
        <h3>A weekly summary that never pads.</h3>
        <p>What changed, what you tried, what is missing and where to focus next. When there is nothing useful to say, it says that instead of inventing advice.</p>
      </div>
      <div class="stage"><Digest /></div>
    </div>
  </div>
</section>

<section class="section" id="audiences">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <h2>Useful before your data is perfect.</h2>
      <p class="lede">Pick the way you sell. The engine is the same. The depth depends on the data you give it.</p>
    </div>
    <div data-reveal><Tabs client:visible /></div>
  </div>
</section>

<section class="section band" id="connections">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <h2>Connect when it helps. Import or type when it does not.</h2>
      <p class="lede">A channel listed here is not always a direct connection. We label exactly what is supported.</p>
    </div>
    <div data-reveal><IntegrationGrid /></div>
    <p class="fine">Direct connections are read-only. <a href="/security/">Read the security details</a>.</p>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <h2>Read before you decide.</h2>
      <p class="lede">Plain-language notes on measuring marketing without fooling yourself.</p>
    </div>
    <div class="res-grid" data-reveal>
      <a class="res" href="/articles/why-your-meta-roas-is-lying-to-you/"><span class="tag">Measurement</span><h3>Why Your Meta ROAS Is Lying to You (And What True ROAS Actually Means)</h3><span class="more">Read the article</span></a>
      <a class="res" href="/articles/the-30-day-return-lag-problem/"><span class="tag">Returns and data lag</span><h3>The 30-Day Return Lag: Why Your Ad Spend Decisions Are Based on Incomplete Data</h3><span class="more">Read the article</span></a>
      <a class="res" href="/articles/cogs-adjusted-profitability/"><span class="tag">Costs and margin</span><h3>COGS-Adjusted Profitability: The One Metric Every DTC Brand Should Track Weekly</h3><span class="more">Read the article</span></a>
    </div>
  </div>
</section>

<section class="section band">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <h2>What people ask first.</h2>
    </div>
    <Faq items={faq} />
    <p class="fine">Something else? <a href="/contact/">Ask us directly</a>.</p>
  </div>
</section>

<Fragment set:html={insight} />

<CtaBand title="Find out what your marketing is really doing." text="Start free with the data you already have." />

</main>
</Layout>
