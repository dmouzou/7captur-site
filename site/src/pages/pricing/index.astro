---
import Layout from "../../layouts/Layout.astro";
import PageHead from "../../components/PageHead.astro";
import Faq from "../../components/Faq.astro";
import CtaBand from "../../components/CtaBand.astro";
import PricingCards from "../../components/PricingCards.tsx";
import plans from "../../data/plans.json";
import { CTA } from "../../data/site";

const S = plans.plans.starter, G = plans.plans.growth;
const dur = (d: number) => (d < 365 ? `${Math.round(d / 30)} month${Math.round(d / 30) === 1 ? "" : "s"}` : `${Math.round(d / 365)} year${Math.round(d / 365) === 1 ? "" : "s"}`);
const yes = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" role="img" aria-label="Yes"><path d="m5 12.5 4.5 4.5L19 7"/></svg>';
const faq = [
  { q: "Is there a free plan?", a: "No. Every new account gets a 14-day free trial of Starter, with no card needed. When the trial ends, pick a plan to keep going." },
  { q: "What happens when my trial ends?", a: "If you do not pick a plan, your account becomes read-only for 30 days. Your data is kept and you can export it at any time. After that, we email you before deleting it." },
  { q: "What does a higher plan change?", a: `More room: ${G.recommendations.weekly / S.recommendations.weekly}x the weekly recommendations, 10x the imports and AI follow-up credits, longer history, more connected platforms per workspace and ${G.maxBusinesses} business workspaces instead of ${S.maxBusinesses}, plus the weekly summary and priority support on Growth. The recommendation engine is the same on every plan. What you can conclude depends on your evidence, not your plan.` },
  { q: "What counts as a connected platform?", a: `A direct, read-only connection to an e-commerce platform (such as Shopify, WooCommerce or Amazon) or an ad account (Google, Meta or TikTok Ads). E-commerce platforms and ad accounts share one pool, and the limit applies to each business workspace separately, because each workspace is its own business. On Growth you can connect up to ${G.maxConnections} in every workspace, for example a different Google Ads account in each of your ${G.maxBusinesses} workspaces. Typing in data or importing a file does not use a connection.` },
  { q: "What is a business workspace?", a: `A separate space for one business, with its own records, recommendations, connections and weekly summary. Your plan sets how many you can have: ${S.maxBusinesses} on Starter and ${G.maxBusinesses} on Growth. They sit under one account and one subscription, and they share the weekly recommendations, imports and AI follow-up credits of your plan.` },
  { q: "What are AI follow-up credits?", a: "Each saved decision lets you ask follow-up questions, such as why one option was chosen over another. One question uses one credit. Starter has 10 credits a month and Growth has 100, with a cap on how many questions one decision can take. Follow-up credits are separate from your weekly recommendations, so asking never uses up a recommendation. Answers are written by AI and can make mistakes. The recommendation itself comes from 7Captur's decision engine and does not change." },
  { q: "What counts as an import?", a: "Any CSV file you bring into the app. Typing records in by hand does not count. Your import allowance resets every month." },
  { q: "How does annual billing work?", a: "Annual saves 20%. You pay once a year, and the price shown is the monthly equivalent. Starter is $468 a year and Growth is $1,908 a year. Monthly billing is available at $49 and $199." },
  { q: "When do weekly limits reset?", a: "Every Monday in your business time zone. Viewing, rereading and exporting recommendations you already have never uses your allowance, and a recommendation that fails to generate is not counted." },
  { q: "What happens if I upgrade or downgrade?", a: "Upgrades take effect straight away and are charged pro rata. Downgrades change your allowance immediately and the new price applies from your next billing date. Nothing is deleted. If a lower plan allows fewer connections, you choose which stay active." },
  { q: "What happens if a payment fails?", a: "We tell you and give you a grace period to fix it. After that, paid-only features are limited. Your history and records are kept." },
  { q: "What happens if I cancel?", a: "You keep your plan until the end of the period you paid for, then your account becomes read-only for 30 days. Your data stays exportable." },
  { q: "Which currency am I charged in, and are taxes included?", a: "Prices are in US dollars. Taxes are shown at checkout where they apply. Each business workspace can still work in its own currency inside the app." },
  { q: "What is Custom?", a: "A plan built around you: more platforms and workspaces, tailored inputs, agreed workflows, priority support and a monthly strategy call. Pricing is agreed with you. <a href=\"/contact/\">Talk to us</a>." },
];
---
<Layout
  title="Pricing | 7Captur"
  description="Try 7Captur free for 14 days, no card needed. Starter from $39 a month billed annually, Growth from $159. Custom plans on request."
  path="/pricing/" current="/pricing/">
<main>
<PageHead title="Simple plans. Pick your room." lede="Every plan uses the same recommendation engine. Plans differ in capacity, connected platforms and support, not in how well we reason." />

<section class="section section-flush" style="padding-bottom:40px">
  <div class="wrap">
    <PricingCards client:load signupUrl={CTA.href} />
    <p class="disclaimer">Prices are in US dollars. Annual plans are billed once a year. Taxes are shown at checkout where they apply. You can upgrade, downgrade or cancel any time. Recommendations are decision support, not a guarantee of sales, savings or profit.</p>
  </div>
</section>

<section class="section" style="padding-top:40px">
  <div class="wrap">
    <p class="kicker">Compare</p>
    <h2>What each plan includes.</h2>
    <div class="table-wrap cmp" tabindex="0" role="region" aria-label="Plan comparison">
      <table>
        <thead><tr><th>Feature</th><th>Starter</th><th>Growth</th><th>Custom</th></tr></thead>
        <tbody>
          <tr><td>Same recommendation engine</td><td class="yes" set:html={yes}></td><td class="yes" set:html={yes}></td><td class="yes" set:html={yes}></td></tr>
          <tr><td>Manual entry and CSV import</td><td class="yes" set:html={yes}></td><td class="yes" set:html={yes}></td><td class="yes" set:html={yes}></td></tr>
          <tr><td>Weekly summary with decision reviews</td><td>No</td><td class="yes" set:html={yes}></td><td class="yes" set:html={yes}></td></tr>
          <tr><td>Recommendations a week, shared by all workspaces</td><td>{S.recommendations.weekly}</td><td>{G.recommendations.weekly} ({G.recommendations.weekly / S.recommendations.weekly}x Starter)</td><td>Agreed</td></tr>
          <tr><td>AI follow-up credits a month</td><td>{S.aiFollowUps}</td><td>{G.aiFollowUps} (10x Starter)</td><td>Agreed</td></tr>
          <tr><td>Imports a month</td><td>{S.importsPerMonth}</td><td>{G.importsPerMonth} (10x Starter)</td><td>Agreed</td></tr>
          <tr><td>History</td><td>{dur(S.historyDays)}</td><td>{dur(G.historyDays)}</td><td>Agreed</td></tr>
          <tr><td>Connected platforms per business workspace</td><td>{S.maxConnections}</td><td>{G.maxConnections}</td><td>Agreed</td></tr>
          <tr><td>Business workspaces</td><td>{S.maxBusinesses}</td><td>{G.maxBusinesses}</td><td>Agreed</td></tr>
          <tr><td>Priority support</td><td>No</td><td class="yes" set:html={yes}></td><td class="yes" set:html={yes}></td></tr>
          <tr><td>Monthly strategy call</td><td>No</td><td>No</td><td class="yes" set:html={yes}></td></tr>
          <tr><td>Price a month, billed annually</td><td>${S.priceAnnualMonthly}</td><td>${G.priceAnnualMonthly}</td><td>On request</td></tr>
          <tr><td>Price a month, billed monthly</td><td>${S.priceMonthly}</td><td>${G.priceMonthly}</td><td>On request</td></tr>
        </tbody>
      </table>
    </div>
  </div>
</section>

<section class="section" style="padding-top:0">
  <div class="wrap">
    <p class="kicker">Questions</p>
    <h2>Pricing, in detail.</h2>
    <Faq items={faq} />
  </div>
</section>

<CtaBand title="Start your 14-day trial." text="Add what you have today. Pick a plan only if it helps." />
</main>
</Layout>
