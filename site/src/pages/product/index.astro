---
import Layout from "../../layouts/Layout.astro";
import PageHead from "../../components/PageHead.astro";
import LoopStory from "../../components/LoopStory.tsx";
import CtaBand from "../../components/CtaBand.astro";
import IntegrationGrid from "../../components/IntegrationGrid.astro";
import Faq from "../../components/Faq.astro";
import Roadmap from "../../components/Roadmap";
import Icon from "../../components/Icon.astro";
import CaptainStory from "../../components/CaptainStory";

const faq = [
  { q: "How is a recommendation decided?", a: "By fixed rules written by us and applied the same way every time. They look at your data, pick an evidence mode, and produce the action, the reasons and the unknowns. Every result is checked before you see it." },
  { q: "What if my data is incomplete or messy?", a: "That is expected. 7Captur works with what you give it, flags what is missing or does not line up, and tells you which single input would improve the next decision most." },
  { q: "What does an evidence label mean?", a: "It tells you where a number came from: entered by you, imported from a file, connected directly, estimated, or unknown. We never present an estimate as a measured fact." },
  { q: "Can 7Captur tell me which post made a sale?", a: "Only when the link is recorded. If you tell us an order came from a post, it is shown as reported by you. If the source is unknown, the sale still counts in your business totals but is not credited to a post." },
];
---
<Layout
  title="Product | 7Captur"
  description="Set a goal, add the data you have, get an evidence-based recommendation, choose whether to act, and learn from the result. No website required."
  path="/product/" current="/product/">
<main>
<PageHead wide title="From the data you have to a clear next step." lede="Setup takes a few minutes. You do not need a website, a store or an ad account. Add more later and the guidance gets sharper." />

<section class="section section-flush" style="padding-bottom:72px">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <h2>Five steps. You set the pace.</h2>
      <p class="lede">Follow the trail from your first goal to the review, then around again. Tap a step to see the real screen.</p>
    </div>
    <Roadmap client:visible />
  </div>
</section>

<section class="section" id="platforms" style="padding-top:0">
  <div class="wrap">
    <p class="kicker">Connections and imports</p>
    <h2>Bring in what you have. Connect where it exists.</h2>
    <p class="lede">Import a CSV or Excel export from the platforms below, type records in, or connect a store or ad account. Connected platforms are read-only and use each platform's own login, and you can disconnect at any time.</p>
    <IntegrationGrid />
    <p class="fine">Need another platform? <a href="/contact/">Tell us which one</a>.</p>
  </div>
</section>

<section class="section" style="padding-top:0">
  <div class="wrap">
    <p class="kicker">Honest by design</p>
    <h2>The advice matches your evidence.</h2>
    <p class="lede">The same engine runs on every plan. It picks its mode from the data in front of it, not from what you pay.</p>
    <div class="table-wrap" tabindex="0" role="region" aria-label="Evidence modes">
      <table>
        <thead><tr><th>Mode</th><th>When</th><th>What it can suggest</th><th>What it will not claim</th></tr></thead>
        <tbody>
          <tr><td>Explore</td><td>Mostly views, reach and engagement</td><td>A small test, comparing content, recording enquiries</td><td>Return, profit or that a post caused sales</td></tr>
          <tr><td>Improve</td><td>Some enquiries or orders, plus spend</td><td>Comparing cost per enquiry or order, improving follow-up</td><td>Profitability without costs</td></tr>
          <tr><td>Optimize</td><td>Reliable spend, revenue, refunds and costs over comparable periods</td><td>Return after declared costs, cautious budget suggestions for you to consider</td><td>Guaranteed future results</td></tr>
        </tbody>
      </table>
    </div>
    <p class="fine">Missing costs are treated as unknown, never as zero. Records in different currencies are not mixed.</p>
  </div>
</section>

<section class="section" id="engine" style="padding-top:0">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <h2>Rules decide. Every result is checked.</h2>
      <p class="lede">Your recommendation is built by fixed rules, not guessed. It is then written up in plain words, and the result is checked before you see it.</p>
    </div>
    <ol class="pipe" data-reveal>
      <li><span class="tile"><Icon name="posts" size={24} /></span><b>Your records</b><span>Posts, promotions, enquiries, sales and costs, each labelled by source.</span><em class="who">You</em></li>
      <li class="arrow" aria-hidden="true"></li>
      <li><span class="tile"><Icon name="understand" size={24} /></span><b>Checks</b><span>Currency, gaps and mismatches are checked. Missing costs stay unknown.</span><em class="who">7Captur rules</em></li>
      <li class="arrow" aria-hidden="true"></li>
      <li><span class="tile"><Icon name="decide" size={24} /></span><b>Recommendation</b><span>An evidence mode is chosen. The action, reasons, unknowns and next measurement are written.</span><em class="who">7Captur rules</em></li>
      <li class="arrow" aria-hidden="true"></li>
      <li><span class="tile"><Icon name="leads" size={24} /></span><b>Plain wording</b><span>The conclusions are written up as a short, friendly summary. Nothing is added to them.</span><em class="who">7Captur</em></li>
      <li class="arrow" aria-hidden="true"></li>
      <li><span class="tile"><Icon name="coins" size={24} /></span><b>Safety check</b><span>Every number must trace back to the engine. Promises, links and unsupported profit claims are rejected.</span><em class="who">7Captur rules</em></li>
    </ol>
    <div class="facts" style="margin-top:40px" data-reveal>
      <div class="fact"><h3>Rules you can read about</h3><p>The action and the reasons come from fixed rules, applied the same way every time. Nothing is guessed.</p></div>
      <div class="fact"><h3>Checked before you see it</h3><p>If the wording adds a number the engine did not produce, or promises a result, it is thrown away.</p></div>
      <div class="fact"><h3>Unknowns stay visible</h3><p>Every recommendation says what the data cannot tell us yet and what to record next.</p></div>
      <div class="fact"><h3>You confirm imports</h3><p>When you import a file, columns are matched for you to review. Nothing is saved until you confirm.</p></div>
    </div>
    <p class="fine">See the <a href="/privacy-policy/">privacy policy</a> for how your data is handled and which providers process it.</p>
  </div>
</section>

<section class="section" id="follow-ups" style="padding-top:0">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <h2>Meet Captain. Ask about any decision.</h2>
      <p class="lede">Want to know why one option beat another, or what would change the answer? Ask Captain. Questions about your numbers are answered straight from them. Open questions are written by AI.</p>
    </div>
    <div data-reveal style="margin-bottom:48px"><CaptainStory client:visible /></div>
    <div class="facts" data-reveal>
      <div class="fact"><h3>The engine decides</h3><p>The recommendation comes from 7Captur's decision engine, using fixed rules. Asking a question never changes it.</p></div>
      <div class="fact"><h3>AI explains</h3><p>Open-ended answers are written by AI and can make mistakes. Check anything important against the numbers shown on the decision.</p></div>
      <div class="fact"><h3>Only the saved summary</h3><p>The AI sees the summary figures saved with the decision, not your individual orders, customers or notes.</p></div>
      <div class="fact"><h3>Separate credits</h3><p>Follow-ups use their own monthly credits, so they never use up your weekly recommendations.</p></div>
    </div>
    <p class="fine">Answers that add numbers the decision does not contain, or promise results, are thrown away. See <a href="/pricing/">pricing</a> for credits on each plan.</p>
  </div>
</section>

<section class="section" id="review" style="padding-top:0">
  <div class="wrap">
    <div class="section-head" data-reveal>
      <h2>Decide. Review. Learn.</h2>
      <p class="lede">Advice is only useful if you can check it later. Every recommendation comes with a date to look back, so advice never goes unchecked.</p>
    </div>
    <div data-reveal><LoopStory client:visible /></div>
    <p class="fine">Starter shows review dates in the app. Growth adds a weekly summary that lists what is waiting for review. Recommendations are decision support. You decide, and you can disagree with any of them.</p>
  </div>
</section>











<section class="section" style="padding-top:0">
  <div class="wrap">
    <p class="kicker">Questions</p>
    <h2>How it behaves with real data.</h2>
    <Faq items={faq} />
  </div>
</section>

<CtaBand title="Try it with the data you already have." text="Add a few posts, a promotion and your enquiries to get your first recommendation." />
</main>
</Layout>
