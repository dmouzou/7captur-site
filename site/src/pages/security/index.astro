---
import Layout from "../../layouts/Layout.astro";
import PageHead from "../../components/PageHead.astro";
import CtaBand from "../../components/CtaBand.astro";
import { siteConfig } from "../../config/siteConfig";
const roles = [
  ["Shopify", "Staff account with Reports and Orders view-only", "No storefront, product or order changes"],
  ["Meta Business Manager", "Ad Account Analyst (view-only)", "No ad edits, no billing"],
  ["Google Ads", "Read-only user invite", "No ad edits, no billing"],
];
const ledeHtml = 'Legal terms are in the <a href="/privacy-policy/">Privacy Policy</a> and <a href="/terms-of-service/">Terms of Service</a>.';
---
<Layout title="Security and Data Handling: Read-Only Access | 7Captur" description="Native read-only roles, no third-party OAuth app installs, isolated client workspaces, no tracking cookies or data resale, and deletion within 48 hours on request." path="/security/" current="/security/">
<main>
  <PageHead wide title="We can read your numbers. We cannot change anything." lede={ledeHtml} />

  <section class="section" style="padding-top:0" aria-labelledby="roles-h">
    <div class="wrap">
      <div class="section-head">
        <h2 id="roles-h">Read-only native roles only</h2>
        <p class="lede">7Captur does not request ad-edit, billing or storefront-write permissions, and does not require third-party OAuth app installs. You invite us using the roles your platforms already provide.</p>
      </div>
      <div class="d-table-wrap" role="region" aria-label="Access roles" tabindex="0">
        <table class="d-matrix">
          <thead><tr><th scope="col">Platform</th><th scope="col">What you grant</th><th scope="col">What is excluded</th></tr></thead>
          <tbody>{roles.map(([p, g, x]) => <tr><th scope="row">{p}</th><td data-label="What you grant">{g}</td><td data-label="What is excluded">{x}</td></tr>)}</tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section band" aria-label="Data handling">
    <div class="wrap">
      <div class="d-grid-3">
        <div class="d-box"><h2>Strict workspace isolation</h2><p>Each client's exports, COGS sheets and past memos live in an isolated logical workspace inside 7Captur's internal infrastructure on Firebase and Google Cloud, encrypted in transit and at rest.</p></div>
        <div class="d-box"><h2>No tracking cookies, no data resale</h2><p>No ad retargeting pixels and no cross-client benchmarking leaks. We do not sell client financial records or use them to train public models.</p></div>
        <div class="d-box"><h2>Clean offboarding and deletion</h2><p>You can revoke our read-only roles in about 30 seconds, at any time. On request we delete all stored exports and memos within 48 hours and confirm the deletion in writing.</p></div>
      </div>
      <p class="d-center d-fine" style="margin-top:28px">Questions about access or data? Email <a href={`mailto:${siteConfig.founder.email}`}>{siteConfig.founder.email}</a>.</p>
    </div>
  </section>

  <CtaBand />
</main>
</Layout>
